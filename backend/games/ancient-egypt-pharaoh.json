  "glossary_terms": [
    {
      "term": "Decision Making",
      "definition": "The process of selecting among alternatives based on available information and values.",
      "example": "Choosing between two career paths based on income, passion, and long-term growth.",
      "deep_dive": "Good decision-making combines rational analysis with awareness of cognitive biases that distort judgment.",
      "real_world_example": "Leaders make high-stakes decisions daily — the quality of their process matters as much as the decision itself."
    },
    {
      "term": "Critical Thinking",
      "definition": "Analyzing information objectively to form a well-reasoned judgment.",
      "example": "Questioning whether a statistic is representative before using it to make a decision.",
      "deep_dive": "Critical thinking involves identifying assumptions, evaluating evidence, and considering alternative perspectives.",
      "real_world_example": "Journalists fact-check before publishing; scientists replicate experiments before claiming discoveries."
    },
    {
      "term": "Growth Mindset",
      "definition": "The belief that abilities can be developed through effort and learning from failure.",
      "example": "Seeing a poor game result as feedback on what to practice, not evidence of being bad at the game.",
      "deep_dive": "Research by Carol Dweck shows people with growth mindsets achieve more and recover better from setbacks.",
      "real_world_example": "Students who believe intelligence is fixed give up when challenged; those with growth mindset persist and improve."
    }
  ],
