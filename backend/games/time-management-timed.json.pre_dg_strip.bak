  "glossary_terms": [
    {
      "term": "Cognitive Load",
      "definition": "The mental effort required to process information and make decisions.",
      "example": "Having too many options at once makes decisions harder and slower.",
      "deep_dive": "Working memory has limits. Experts chunk information into patterns, reducing cognitive load and enabling faster decisions.",
      "real_world_example": "Experienced doctors diagnose faster not because they think harder, but because they recognize patterns instantly."
    },
    {
      "term": "Pattern Recognition",
      "definition": "Identifying recurring structures or relationships in information.",
      "example": "Noticing that certain question types always have two plausible answers helps you focus faster.",
      "deep_dive": "Pattern recognition is a core skill in chess, medicine, engineering, and sport. It develops through deliberate practice.",
      "real_world_example": "Air traffic controllers recognize dangerous flight patterns faster than computers because of years of pattern training."
    },
    {
      "term": "Focus",
      "definition": "The ability to direct mental attention toward what matters most and ignore distractions.",
      "example": "Under time pressure, completing questions you're confident about before tackling harder ones.",
      "deep_dive": "Focus is a trainable skill. The Pomodoro method, mindfulness, and deliberate practice all improve sustained attention.",
      "real_world_example": "Olympic athletes train mental focus as rigorously as physical skills — pressure performance depends on it."
    }
  ],
