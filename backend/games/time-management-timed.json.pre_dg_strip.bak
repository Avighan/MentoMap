{
  "game_id": "time_management_timed_challenge",
  "title": "Beat the Clock: Time Management Mastery",
  "theme": "Time Management & Productivity for Students",
  "description": "Think fast! 15 rapid-fire questions about time management, productivity hacks, study techniques, and beating procrastination. Learn the Eisenhower Matrix, Pomodoro Technique, and smart goal-setting -- all while racing against the clock! Every second counts!",
  "game_type": "minigame",
  "target_audience": "12-18",
  "duration_minutes": 5,
  "difficulty": "intermediate",
  "learning_objectives": [
    "Understand the Eisenhower Matrix for task prioritization",
    "Learn practical study techniques like Pomodoro and active recall",
    "Identify and overcome common procrastination patterns",
    "Develop SMART goal-setting skills for academic and personal life"
  ],
  "how_to_play": {
    "title": "How to Play",
    "steps": [
      "Read each question about time management, study techniques, or productivity",
      "Select your answer before the 12-second timer runs out",
      "Earn 10 points per correct answer, plus streak bonuses for consecutive correct answers",
      "Work through all 15 questions covering the Eisenhower Matrix, Pomodoro Technique, and SMART goals",
      "Review your results to discover which time management strategies you already know"
    ],
    "tips": [
      "Read the full question before looking at options -- scenario questions need careful attention",
      "Build answer streaks for extra points -- each consecutive correct answer earns a 5-point bonus",
      "Think about how you would actually handle each scenario in real life to find the best answer"
    ]
  },
  "psychological_skills": [
    "time_management",
    "self_regulation",
    "decision_making",
    "goal_orientation",
    "metacognition"
  ],
