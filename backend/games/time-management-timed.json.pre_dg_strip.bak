  "minigame_config": {
    "subtype": "timed_challenge",
    "time_per_question": 25,
    "scoring": {
      "correct_points": 10,
      "streak_bonus": 5
    },
    "questions": [
      {
        "id": "q1",
        "question": "You have a Maths exam tomorrow, a friend's birthday party tonight, your room to clean, and a library book due next week. Using the Eisenhower Matrix, which task is 'Urgent AND Important'?",
        "options": [
          "Friend's birthday party",
          "Studying for the Maths exam",
          "Cleaning your room",
          "Returning the library book"
        ],
        "correct_answer": "Studying for the Maths exam",
        "category": "eisenhower_matrix"
      },
      {
        "id": "q2",
        "question": "In the Eisenhower Matrix, what should you do with tasks that are 'Not Urgent AND Not Important'?",
        "options": [
          "Do them first as a warm-up",
          "Delegate them to someone",
          "Eliminate or minimize them",
          "Schedule them for the weekend"
        ],
        "correct_answer": "Eliminate or minimize them",
        "category": "eisenhower_matrix"
      },
      {
        "id": "q3",
        "question": "The Pomodoro Technique involves studying in focused bursts. How long is one standard 'Pomodoro' session?",
        "options": [
          "15 minutes",
          "25 minutes",
          "45 minutes",
          "60 minutes"
        ],
        "correct_answer": "25 minutes",
        "category": "study_techniques"
      },
      {
        "id": "q4",
        "question": "Scenario: You keep telling yourself 'I'll start studying after one more episode.' This is an example of:",
        "options": [
          "Active recall",
          "Time blocking",
          "Procrastination through delay rewards",
          "The Pareto Principle"
        ],
        "correct_answer": "Procrastination through delay rewards",
        "category": "procrastination"
      },
      {
        "id": "q5",
        "question": "Which study method is scientifically proven to be MOST effective for long-term memory retention?",
        "options": [
          "Re-reading textbook chapters multiple times",
          "Highlighting key sentences in yellow",
          "Active recall -- testing yourself without looking at notes",
          "Copying notes word-for-word into a new notebook"
        ],
        "correct_answer": "Active recall -- testing yourself without looking at notes",
        "category": "study_techniques"
      },
      {
        "id": "q6",
        "question": "You want to 'Score 90% in Science.' Is this a SMART goal?",
        "options": [
          "Yes, it's specific and measurable",
          "No, it's missing a time deadline",
          "No, goals should never have numbers",
          "Yes, because it mentions a subject"
        ],
        "correct_answer": "No, it's missing a time deadline",
        "category": "goal_setting"
      },
      {
        "id": "q7",
        "question": "It's 4 PM. You have homework (due tomorrow), cricket practice at 6 PM, and want to watch a YouTube video. Best order?",
        "options": [
          "YouTube first to relax, then homework after cricket",
          "Homework now (4-5:30), cricket (6-7), YouTube as reward after",
          "Skip cricket to finish homework and watch YouTube",
          "Do homework during cricket breaks on your phone"
        ],
        "correct_answer": "Homework now (4-5:30), cricket (6-7), YouTube as reward after",
        "category": "prioritization"
      },
      {
        "id": "q8",
        "question": "The '2-Minute Rule' in productivity says: if a task takes less than 2 minutes...",
        "options": [
          "Skip it, it's not important enough",
          "Add it to your to-do list for later",
          "Do it immediately right now",
          "Delegate it to someone else"
        ],
        "correct_answer": "Do it immediately right now",
        "category": "productivity_hacks"
      },
      {
        "id": "q9",
        "question": "Spaced repetition means:",
        "options": [
          "Studying the same topic for 6 hours straight",
          "Reviewing material at increasing intervals over days/weeks",
          "Repeating a sentence 100 times to memorize it",
          "Spacing out your desk so you have more room"
        ],
        "correct_answer": "Reviewing material at increasing intervals over days/weeks",
        "category": "study_techniques"
      },
      {
        "id": "q10",
        "question": "You're feeling overwhelmed by a huge Science project. The best first step is:",
        "options": [
          "Panic and complain to friends on WhatsApp",
          "Break it into small, manageable sub-tasks with deadlines",
          "Start doing everything at once and hope for the best",
          "Wait until the night before -- pressure helps you focus"
        ],
        "correct_answer": "Break it into small, manageable sub-tasks with deadlines",
        "category": "prioritization"
      },
      {
        "id": "q11",
        "question": "The Pareto Principle (80/20 rule) applied to studying means:",
        "options": [
          "Study 80% of the time and rest 20%",
          "80% of your marks come from mastering 20% of the most important topics",
          "Read 80 pages and skip 20 pages",
          "Study for 80 minutes, break for 20 minutes"
        ],
        "correct_answer": "80% of your marks come from mastering 20% of the most important topics",
        "category": "productivity_hacks"
      },
      {
        "id": "q12",
        "question": "Which of these is the BIGGEST time-waster for students, according to research?",
        "options": [
          "Taking short breaks between study sessions",
          "Multitasking -- studying while checking Instagram notifications",
          "Sleeping 8 hours a night",
          "Having a study group discussion"
        ],
        "correct_answer": "Multitasking -- studying while checking Instagram notifications",
        "category": "procrastination"
      },
      {
        "id": "q13",
        "question": "Time blocking is a technique where you:",
        "options": [
          "Block all distracting apps permanently",
          "Assign specific time slots to specific tasks on your calendar",
          "Study only at night when it's quiet",
          "Block out everyone and study alone always"
        ],
        "correct_answer": "Assign specific time slots to specific tasks on your calendar",
        "category": "productivity_hacks"
      },
      {
        "id": "q14",
        "question": "Your Board exams are in 3 months. Using backward planning, you should:",
        "options": [
          "Start studying the night before each exam",
          "Start from the exam date and work backward to create a daily study schedule",
          "Study only your favourite subjects first",
          "Wait for your teacher to tell you when to start"
        ],
        "correct_answer": "Start from the exam date and work backward to create a daily study schedule",
        "category": "goal_setting"
      },
      {
        "id": "q15",
        "question": "'Eat the Frog' is a productivity concept that means:",
        "options": [
          "Have a healthy breakfast before studying",
          "Do the hardest, most important task FIRST thing in the day",
          "Take lots of small breaks like a frog hopping",
          "Avoid difficult tasks and start with easy ones"
        ],
        "correct_answer": "Do the hardest, most important task FIRST thing in the day",
        "category": "productivity_hacks"
      }
    ]
  },
