  "glossary_terms": [
    {
      "term": "BATNA",
      "definition": "Best Alternative To a Negotiated Agreement — your fallback if talks fail.",
      "example": "If the salary offer is too low, your BATNA might be another job offer."
    },
    {
      "term": "Anchoring",
      "definition": "Setting the first number in a negotiation to frame expectations.",
      "example": "Opening with a high price so the final agreed price feels like a win for the other side."
    },
    {
      "term": "Rapport",
      "definition": "A sense of mutual understanding and trust between negotiating parties.",
      "example": "Building rapport through small talk before getting to the main ask."
    }
  ],
